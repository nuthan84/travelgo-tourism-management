# TravelGo Backend Environment Configuration Example
# Copy this file to .env and set your credentials

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/tourism_db
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# JWT Authentication (256-bit Hex or Base64 secret key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Cloudinary Credentials (For package and destination images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Credentials (For test/production payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
